* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: #080808;
  color: white;
  font-family: Arial, sans-serif;
  min-height: 100vh;
}

header {
  height: 65px;
  background: #111;
  border-bottom: 1px solid #292929;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 18px;

  position: sticky;
  top: 0;
  z-index: 20;
}

.logo {
  font-size: 18px;
  font-weight: 800;
}

.menu-btn {
  background: none;
  color: white;
  border: 0;
  font-size: 27px;
  cursor: pointer;
}

.hero {
  text-align: center;
  padding: 45px 15px 25px;
}

.hero h1 {
  font-size: 28px;
}

.hero p {
  margin-top: 10px;
  color: #aaa;
}

.products-section {
  max-width: 1100px;
  margin: auto;
  padding: 15px;
}

.products-section h2 {
  margin-bottom: 15px;
}

.products {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.product {
  background: #151515;
  border: 1px solid #292929;
  border-radius: 12px;
  padding: 16px;
}

.product h3 {
  min-height: 45px;
  font-size: 15px;
}

.price {
  font-size: 18px;
  font-weight: bold;
  margin: 12px 0;
}

.buy-btn,
.primary-btn {
  width: 100%;
  border: 0;
  border-radius: 8px;
  padding: 13px;
  background: #00c853;
  color: white;
  font-weight: bold;
  cursor: pointer;
}

.panel {
  max-width: 600px;
  margin: 20px auto;
  padding: 20px;
  background: #141414;
  border: 1px solid #292929;
  border-radius: 14px;
}

.panel h2 {
  margin-bottom: 20px;
}

.selected-product,
.bank-details {
  background: #0d0d0d;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 15px;
}

.selected-product p,
.bank-details span {
  display: block;
  color: #888;
  font-size: 12px;
  margin-bottom: 5px;
}

.selected-product strong {
  display: block;
  margin-bottom: 15px;
}

.bank-details p {
  margin-top: 15px;
}

.panel input,
.admin-panel input {
  width: 100%;
  padding: 14px;
  margin-bottom: 12px;
  border-radius: 8px;
  border: 1px solid #333;
  background: #0c0c0c;
  color: white;
  outline: none;
}

.back-btn,
.refresh-btn {
  border: 0;
  padding: 10px 14px;
  border-radius: 7px;
  background: #252525;
  color: white;
  cursor: pointer;
  margin-bottom: 20px;
}

.hidden {
  display: none !important;
}

.order-number {
  margin-top: 15px;
  color: #aaa;
}

.status {
  padding: 16px;
  border-radius: 10px;
  background: #202020;
  font-weight: bold;
  text-align: center;
}

.status.approved {
  background: #075d2d;
}

.status.declined {
  background: #6d1111;
}

.status.injecting {
  background: #164e70;
}

.status.injected {
  background: #087c3b;
}

/* SIDE MENU */

.overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.7);
  z-index: 30;
}

#sideMenu {
  position: fixed;
  right: -300px;
  top: 0;
  width: 280px;
  height: 100%;
  background: #151515;
  padding: 25px;
  z-index: 40;
  transition: .25s;
}

#sideMenu.active {
  right: 0;
}

#sideMenu.active + .overlay {
  display: block;
}

.close-btn {
  float: right;
  background: none;
  border: 0;
  color: white;
  font-size: 25px;
  cursor: pointer;
}

#sideMenu h2 {
  margin: 55px 0 20px;
}

#sideMenu button,
#sideMenu a {
  display: block;
  width: 100%;
  padding: 14px;
  margin-top: 12px;

  background: #222;
  color: white;
  border: 0;
  border-radius: 8px;

  text-decoration: none;
  text-align: center;
  cursor: pointer;
}

/* ADMIN */

.admin-panel {
  max-width: 800px;
  margin: 30px auto;
  padding: 20px;
}

.admin-order {
  background: #151515;
  border: 1px solid #292929;
  border-radius: 12px;
  padding: 18px;
  margin-bottom: 15px;
}

.admin-order h3 {
  margin-bottom: 10px;
}

.admin-order p {
  margin: 7px 0;
  color: #ccc;
}

.admin-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 15px;
}

.approve {
  background: #00a844;
  color: white;
}

.decline {
  background: #a40000;
  color: white;
}

.injecting {
  background: #176a98;
  color: white;
}

.injected {
  background: #00843d;
  color: white;
}

.admin-actions button {
  border: 0;
  padding: 12px;
  border-radius: 7px;
  font-weight: bold;
  cursor: pointer;
}

@media (min-width: 700px) {
  .products {
    grid-template-columns: repeat(4, 1fr);
  }
}
let products = [];
let selectedProduct = null;
let currentOrderId = null;
let adminKey = null;
let statusTimer = null;

const money = amount =>
  "₦" + Number(amount).toLocaleString();

async function loadProducts() {

  const response =
    await fetch("/api/products");

  products = await response.json();

  displayProducts();
}

function displayProducts() {

  const container =
    document.getElementById("products");

  container.innerHTML = "";

  products.forEach(product => {

    container.innerHTML += `
      <article class="product">

        <h3>
          ${product.id}/ ${product.name}
        </h3>

        <div class="price">
          ${money(product.price)}
        </div>

        <button
          class="buy-btn"
          onclick="buyProduct(${product.id})">
          BUY
        </button>

      </article>
    `;
  });
}

function buyProduct(id) {

  selectedProduct =
    products.find(product => product.id === id);

  document.getElementById("selectedProduct")
    .textContent = selectedProduct.name;

  document.getElementById("selectedAmount")
    .textContent = money(selectedProduct.price);

  document
    .getElementById("paymentSection")
    .classList.remove("hidden");

  window.scrollTo({
    top: document.getElementById("paymentSection").offsetTop,
    behavior: "smooth"
  });
}

function closePayment() {

  document
    .getElementById("paymentSection")
    .classList.add("hidden");

  document
    .getElementById("paymentForm")
    .classList.add("hidden");
}

function showPaymentForm() {

  document
    .getElementById("paymentForm")
    .classList.remove("hidden");

  document.getElementById("paymentForm")
    .scrollIntoView({
      behavior: "smooth"
    });
}

async function submitPayment() {

  const customerName =
    document.getElementById("customerName")
      .value.trim();

  const transactionId =
    document.getElementById("transactionId")
      .value.trim();

  const message =
    document.getElementById("formMessage");

  if (!customerName || !transactionId) {

    message.textContent =
      "Please enter your name and transaction ID.";

    return;
  }

  message.textContent = "Submitting...";

  const response = await fetch("/api/orders", {

    method: "POST",

    headers: {
      "Content-Type": "application/json"
    },

    body: JSON.stringify({
      productId: selectedProduct.id,
      customerName,
      transactionId
    })

  });

  const data = await response.json();

  if (!response.ok) {

    message.textContent =
      data.error || "Something went wrong.";

    return;
  }

  currentOrderId = data.id;

  document.getElementById("orderId")
    .textContent = currentOrderId;

  document
    .getElementById("orderSection")
    .classList.remove("hidden");

  document.getElementById("orderStatus")
    .innerHTML =
      `<div class="status">
        🟡 PENDING REQUEST
      </div>`;

  message.textContent = "";

  startStatusChecking();

  document.getElementById("orderSection")
    .scrollIntoView({
      behavior: "smooth"
    });
}

function startStatusChecking() {

  if (statusTimer) {
    clearInterval(statusTimer);
  }

  statusTimer =
    setInterval(checkOrder, 5000);
}

async function checkOrder() {

  if (!currentOrderId) return;

  const response =
    await fetch(
      `/api/orders/${currentOrderId}`
    );

  if (!response.ok) return;

  const order =
    await response.json();

  let html = "";

  if (order.paymentStatus === "PENDING REQUEST") {

    html = `
      <div class="status">
        🟡 PENDING REQUEST
      </div>
    `;

  } else if (order.paymentStatus === "APPROVED") {

    html = `
      <div class="status approved">
        ✅ APPROVED
      </div>
    `;

    if (order.injectionStatus === "INJECTING") {

      html += `
        <div class="status injecting">
          🔵 INJECTING
        </div>
      `;

    } else if (order.injectionStatus === "INJECTED") {

      html += `
        <div class="status injected">
          🟢 INJECTED
        </div>
      `;

    }

  } else if (order.paymentStatus === "DECLINED") {

    html = `
      <div class="status declined">
        ❌ DECLINED
      </div>
    `;
  }

  document.getElementById("orderStatus")
    .innerHTML = html;
}

/* MENU */

function openMenu() {

  document
    .getElementById("sideMenu")
    .classList.add("active");

  document
    .getElementById("menuOverlay")
    .style.display = "block";
}

function closeMenu() {

  document
    .getElementById("sideMenu")
    .classList.remove("active");

  document
    .getElementById("menuOverlay")
    .style.display = "none";
}

/* ADMIN */

function showAdminLogin() {

  closeMenu();

  document
    .getElementById("adminLogin")
    .classList.remove("hidden");

  window.scrollTo({
    top: document.body.scrollHeight,
    behavior: "smooth"
  });
}

async function adminLogin() {

  const key =
    document.getElementById("adminKey").value;

  const message =
    document.getElementById("adminMessage");

  if (!key) {

    message.textContent =
      "Enter the admin access key.";

    return;
  }

  const response =
    await fetch("/api/admin/orders", {
      headers: {
        "x-admin-key": key
      }
    });

  if (!response.ok) {

    message.textContent =
      "❌ ACCESS DENIED";

    return;
  }

  adminKey = key;

  message.textContent =
    "✅ ACCESS GRANTED";

  document
    .getElementById("adminLogin")
    .classList.add("hidden");

  document
    .getElementById("adminDashboard")
    .classList.remove("hidden");

  loadOrders();
}

async function loadOrders() {

  const container =
    document.getElementById("adminOrders");

  container.innerHTML =
    "<p>Loading orders...</p>";

  const response =
    await fetch("/api/admin/orders", {

      headers: {
        "x-admin-key": adminKey
      }

    });

  if (!response.ok) {

    container.innerHTML =
      "<p>Admin access expired.</p>";

    return;
  }

  const orders =
    await response.json();

  if (orders.length === 0) {

    container.innerHTML =
      "<p>No orders yet.</p>";

    return;
  }

  container.innerHTML = "";

  orders.reverse().forEach(order => {

    container.innerHTML += `

      <div class="admin-order">

        <h3>${order.product}</h3>

        <p>
          <strong>Order ID:</strong>
          ${order.id}
        </p>

        <p>
          <strong>Customer:</strong>
          ${escapeHtml(order.customerName)}
        </p>

        <p>
          <strong>Amount:</strong>
          ${money(order.amount)}
        </p>

        <p>
          <strong>Transaction ID:</strong>
          ${escapeHtml(order.transactionId)}
        </p>

        <p>
          <strong>Payment:</strong>
          ${order.paymentStatus}
        </p>

        <p>
          <strong>Injection:</strong>
          ${order.injectionStatus || "NOT STARTED"}
        </p>

        <div class="admin-actions">

          <button
            class="approve"
            onclick="paymentDecision(
              '${order.id}',
              'APPROVED'
            )">
            APPROVED
          </button>

          <button
            class="decline"
            onclick="paymentDecision(
              '${order.id}',
              'DECLINED'
            )">
            DECLINED
          </button>

          <button
            class="injecting"
            onclick="injectionDecision(
              '${order.id}',
              'INJECTING'
            )">
            INJECTING
          </button>

          <button
            class="injected"
            onclick="injectionDecision(
              '${order.id}',
              'INJECTED'
            )">
            INJECTED
          </button>

        </div>

      </div>
    `;
  });
}

async function paymentDecision(id, status) {

  const response =
    await fetch(
      `/api/admin/orders/${id}/payment`,
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
          "x-admin-key": adminKey
        },

        body: JSON.stringify({ status })
      }
    );

  if (response.ok) {
    loadOrders();
  }
}

async function injectionDecision(id, status) {

  const response =
    await fetch(
      `/api/admin/orders/${id}/injection`,
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
          "x-admin-key": adminKey
        },

        body: JSON.stringify({ status })
      }
    );

  const data = await response.json();

  if (!response.ok) {
    alert(data.error);
    return;
  }

  loadOrders();
}

function closeAdmin() {

  document
    .getElementById("adminLogin")
    .classList.add("hidden");

  document
    .getElementById("adminDashboard")
    .classList.add("hidden");

  adminKey = null;
}

function escapeHtml(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

loadProducts();
